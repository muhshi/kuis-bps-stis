# Konfigurasi Port
PORT=3000

# Konfigurasi Koneksi PostgreSQL (Hubungkan ke PostgreSQL yang sudah ada di Ubuntu Server)
# Jika PostgreSQL ada di host Docker Ubuntu: gunakan host.docker.internal atau IP LAN server
PGHOST=host.docker.internal
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_password
PGDATABASE=kuis_stis

# Atau gunakan full connection string URL:
# DATABASE_URL=postgres://postgres:your_secure_password@host.docker.internal:5432/kuis_stis

# Token Keamanan untuk Download Data Peserta (CSV)
ADMIN_TOKEN=bps-stis-2026
